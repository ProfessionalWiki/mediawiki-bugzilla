{
	"require-dev": {
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"mediawiki/mediawiki-codesniffer": "^45.0"
	},
	"scripts": {
		"fix": "phpcbf",
		"test": [
			"parallel-lint . --exclude vendor",
			"phpcs -p -s"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
